{
  "checks": [
    {
      "name": "tests",
      "argv": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-v"],
      "kind": "unittest"
    }
  ],
  "protected": ["pyproject.toml", "setup.cfg"],
  "limits": {
    "max_steps": 100,
    "max_total_tokens": 1000000,
    "max_output_tokens": 8192,
    "max_seconds": 3600,
    "command_timeout": 120
  }
}
